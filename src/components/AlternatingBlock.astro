---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  side?: 'left' | 'right';
  aspectRatio?: string;
  fit?: 'cover' | 'contain';
  rotate?: number;
}

const { image, alt, side = 'left', aspectRatio = '4/3', fit = 'cover', rotate } = Astro.props;
---

<div class:list={['alt-block', side === 'right' && 'alt-block--reverse']}>
  <div class="alt-block__media" style={`aspect-ratio:${aspectRatio}`}>
    {image ? (
      <Image
        src={image}
        alt={alt}
        style={`object-fit:${fit};${rotate ? `transform:rotate(${rotate}deg);` : ''}`}
        widths={[400, 800, 1200]}
        sizes="(max-width: 700px) 100vw, 440px"
      />
    ) : (
      <div class="alt-block__placeholder">{alt}</div>
    )}
  </div>
  <div class="alt-block__text">
    <slot />
  </div>
</div>

<style>
  .alt-block {
    display: flex;
    gap: 40px;
    align-items: center;
    margin-top: 56px;
    flex-wrap: wrap;
  }

  .alt-block--reverse {
    flex-direction: row-reverse;
  }

  .alt-block__media {
    flex: 1;
    width: 100%;
    min-width: 260px;
    overflow: hidden;
  }

  .alt-block__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .alt-block__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
    border: 1px dashed color-mix(in srgb, var(--color-ink) 25%, transparent);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .alt-block__text {
    flex: 1;
    min-width: 260px;
  }

  .alt-block__text :global(h3) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 24px;
    color: var(--color-ink);
    margin: 0 0 14px;
    font-weight: 400;
  }

  .alt-block__text :global(p) {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-body);
    margin: 0;
  }

  .alt-block__text :global(.alt-block__eyebrow) {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 8px;
  }
</style>
