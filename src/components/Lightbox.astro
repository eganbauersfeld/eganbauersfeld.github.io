---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  aspectRatio: string;
}

const { src, alt, aspectRatio } = Astro.props;
const full = await getImage({ src, width: Math.min(src.width, 1800) });
---

<button
  type="button"
  class="lightbox-trigger"
  data-lightbox-src={full.src}
  data-lightbox-alt={alt}
  style={`aspect-ratio:${aspectRatio}`}
  aria-label={`Enlarge: ${alt}`}
>
  <Image src={src} alt={alt} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 420px" />
</button>

<style>
  .lightbox-trigger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .lightbox-trigger :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
