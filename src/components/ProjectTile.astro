---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  index: string;
  title: string;
  typeLabel: string;
  accentColor: string;
  size: 'large' | 'medium' | 'small';
  image?: ImageMetadata;
  imagePosition?: string;
  /**
   * Width (% of the tile) for a photo panel on the right side. Use for tall photos that crop
   * too tight across the whole tile: the panel shows more of the photo and the rest of the tile
   * is filled with a blurred copy of it.
   */
  imagePanel?: number;
}

const { href, index, title, typeLabel, accentColor, size, image, imagePosition = '50% 50%', imagePanel } = Astro.props;
const widths = size === 'large' ? [700, 1400] : [400, 800];
const sizes = size === 'large' ? '(max-width: 900px) 100vw, 720px' : '(max-width: 900px) 50vw, 300px';
---

<a href={href} class:list={['tile', `tile--${size}`, image && 'tile--photo']} style={`background:${accentColor}`}>
  {image && imagePanel && (
    <Image src={image} alt="" class="tile__photo tile__photo--fill" widths={[200]} sizes="200px" />
  )}
  {image && (
    <Image
      src={image}
      alt=""
      class:list={['tile__photo', imagePanel && 'tile__photo--panel']}
      style={`object-position:${imagePosition}` + (imagePanel ? `;--panel:${imagePanel}%` : '')}
      widths={widths}
      sizes={sizes}
    />
  )}
  <span class="tile__index">{index}</span>
  <span class="tile__title">{title}</span>
  <span class="tile__type">{typeLabel}</span>
</a>

<style>
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    color: var(--color-surface) !important;
    transition: transform var(--duration-standard) var(--ease-standard);
  }

  .tile--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(20 16 12 / 0.78) 0%, rgb(20 16 12 / 0.25) 55%, rgb(20 16 12 / 0.35) 100%);
    pointer-events: none;
  }

  .tile__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-standard) var(--ease-standard);
  }

  .tile__photo--panel {
    left: auto;
    width: var(--panel);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 22%);
    mask-image: linear-gradient(to right, transparent, #000 22%);
  }

  /* Blurred copy of the photo that fills the tile behind a photo panel */
  .tile__photo--fill {
    filter: blur(16px) brightness(0.7) saturate(1.1);
    transform: scale(1.2);
  }

  .tile--photo:hover .tile__photo:not(.tile__photo--fill) {
    transform: scale(1.04);
  }

  .tile__index,
  .tile__title,
  .tile__type {
    position: relative;
    z-index: 1;
  }

  .tile:hover {
    transform: scale(1.01);
    color: var(--color-surface) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
    .tile__photo {
      transition: none;
    }
    .tile:hover,
    .tile--photo:hover .tile__photo:not(.tile__photo--fill) {
      transform: none;
    }
  }

  .tile__index {
    position: absolute;
    font-family: var(--font-mono);
    color: var(--color-surface);
  }

  .tile__title {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-surface);
    line-height: 1.1;
  }

  .tile__type {
    font-family: var(--font-body);
    color: color-mix(in srgb, var(--color-surface) 87%, transparent);
  }

  .tile--large {
    padding: 24px 26px;
  }
  .tile--large .tile__index {
    top: 20px;
    left: 24px;
    font-size: 14px;
  }
  .tile--large .tile__title {
    font-size: 34px;
  }
  .tile--large .tile__type {
    font-size: 14px;
    margin-top: 6px;
  }

  .tile--medium {
    padding: 18px 20px;
  }
  .tile--medium .tile__index {
    top: 16px;
    left: 18px;
    font-size: 13px;
  }
  .tile--medium .tile__title {
    font-size: 22px;
  }
  .tile--medium .tile__type {
    font-size: 12px;
    margin-top: 4px;
  }

  .tile--small {
    padding: 16px 18px;
  }
  .tile--small .tile__index {
    top: 14px;
    left: 16px;
    font-size: 12px;
  }
  .tile--small .tile__title {
    font-size: 19px;
  }
  .tile--small .tile__type {
    font-size: 11px;
    margin-top: 3px;
  }
</style>
