---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Egan Bauersfeld — Integrated Design Engineer, CU Boulder' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <slot />

    <div id="lightbox-overlay" class="lightbox-overlay" hidden>
      <button type="button" class="lightbox-overlay__close" aria-label="Close">Close ✕</button>
      <img id="lightbox-overlay__image" class="lightbox-overlay__image" alt="" />
    </div>
  </body>
</html>

<style>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-ink) 90%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }

  .lightbox-overlay[hidden] {
    display: none;
  }

  .lightbox-overlay__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .lightbox-overlay__close {
    position: absolute;
    top: 14px;
    right: 24px;
    background: none;
    border: 0;
    color: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
</style>

<script>
  const overlay = document.getElementById('lightbox-overlay') as HTMLElement;
  const overlayImage = document.getElementById('lightbox-overlay__image') as HTMLImageElement;

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const trigger = target.closest('.lightbox-trigger') as HTMLElement | null;
    if (trigger) {
      overlayImage.src = trigger.dataset.lightboxSrc ?? '';
      overlayImage.alt = trigger.dataset.lightboxAlt ?? '';
      overlay.hidden = false;
      return;
    }
    if (target.closest('.lightbox-overlay__close') || target === overlay) {
      overlay.hidden = true;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') overlay.hidden = true;
  });
</script>
